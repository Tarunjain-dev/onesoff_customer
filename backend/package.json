{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "postinstall": "prisma generate",
    "predev": "prisma generate",
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/server.ts",
    "build": "tsc",
    "prestart": "prisma generate",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node -r tsconfig-paths/register prisma/seed.ts",
    "prisma:seed:minimal": "ts-node -r tsconfig-paths/register prisma/seed-minimal.ts",
    "backfill:complaints": "ts-node -r tsconfig-paths/register scripts/backfill-complaints.ts",
    "backfill:notifications": "ts-node -r tsconfig-paths/register scripts/backfill-notifications.ts",
    "backfill:product-approval-flows": "ts-node --transpile-only -r tsconfig-paths/register scripts/backfill-product-approval-flows.ts",
    "backfill:vendor-profile-data": "ts-node --transpile-only -r tsconfig-paths/register scripts/backfill-vendor-profile-data.ts",
    "backfill:vendor-profile-media": "ts-node -r tsconfig-paths/register scripts/backfill-vendor-profile-media.ts",
    "check-setup": "ts-node -r tsconfig-paths/register check-setup.ts"
  },
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.993.0",
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "^7.4.0",
    "aws-sdk": "^2.1693.0",
    "axios": "^1.13.5",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase-admin": "^13.6.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.8",
    "pg": "^8.18.0",
    "pino": "^10.3.1",
    "razorpay": "^2.9.6",
    "socket.io": "^4.8.3",
    "twilio": "^5.12.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/helmet": "^0.0.48",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.2.3",
    "@types/pg": "^8.16.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.4.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
