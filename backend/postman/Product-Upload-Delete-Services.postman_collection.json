{
  "info": {
    "name": "OnesOff Product Upload & Management Services",
    "description": "Focused Postman collection for vendor product flows: vendor auth, product image upload, image delete, product create/update/get, and variant add.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "vendorPhone",
      "value": "9876543211",
      "type": "string"
    },
    {
      "key": "otp",
      "value": "123456",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "",
      "type": "string"
    },
    {
      "key": "imageUrl",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Vendor Auth Setup",
      "item": [
        {
          "name": "Vendor Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Vendor Name\",\n  \"email\": \"vendor@example.com\",\n  \"phone\": \"{{vendorPhone}}\",\n  \"password\": \"Password123!\",\n  \"shopName\": \"My Rental Shop\",\n  \"ownerName\": \"Shop Owner\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/vendor/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "vendor",
                "register"
              ]
            }
          }
        },
        {
          "name": "Vendor Send OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{vendorPhone}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/vendor/send-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "vendor",
                "send-otp"
              ]
            }
          }
        },
        {
          "name": "Vendor Verify OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const response = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', response.data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', response.data.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{vendorPhone}}\",\n  \"otp\": \"{{otp}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/vendor/verify-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "vendor",
                "verify-otp"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Product Upload & Delete",
      "item": [
        {
          "name": "Upload Product Images (Vendor)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const response = pm.response.json();",
                  "  const urls = response?.data?.imageUrls || [];",
                  "  if (urls.length > 0) pm.collectionVariables.set('imageUrl', urls[0]);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "images",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/upload/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "upload",
                "products"
              ]
            }
          }
        },
        {
          "name": "Delete Uploaded Image",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"imageUrl\": \"{{imageUrl}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/upload/image",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "upload",
                "image"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Product Services",
      "item": [
        {
          "name": "Create Product (Vendor)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const response = pm.response.json();",
                  "  const id = response?.data?.id;",
                  "  if (id) pm.collectionVariables.set('productId', id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Canon DSLR Camera\",\n  \"description\": \"Professional DSLR camera with 24MP sensor\",\n  \"category\": \"Electronics\",\n  \"rentalPrice\": 500,\n  \"securityDeposit\": 5000,\n  \"quantity\": 3,\n  \"images\": [\"{{imageUrl}}\"],\n  \"specifications\": {\n    \"brand\": \"Canon\",\n    \"model\": \"EOS 90D\",\n    \"megapixels\": \"24MP\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            }
          }
        },
        {
          "name": "Get All Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?page=1&limit=12",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "12"
                }
              ]
            }
          }
        },
        {
          "name": "Get Product by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{productId}}"
              ]
            }
          }
        },
        {
          "name": "Update Product (Vendor)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rentalPrice\": 450,\n  \"quantity\": 5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{productId}}"
              ]
            }
          }
        },
        {
          "name": "Add Product Variant (Vendor)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"With Extra Lens\",\n  \"priceAdjustment\": 200,\n  \"depositAdjustment\": 1000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/variants",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{productId}}",
                "variants"
              ]
            }
          }
        }
      ]
    }
  ]
}
