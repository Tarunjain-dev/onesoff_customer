# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"

# Firebase Admin SDK (FCM)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Use literal \n for newlines in env files
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"

# AWS S3
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# =========================
# SMS (MSG91 + Twilio backup)
# =========================

# MSG91 (Flow API recommended)
# Code supports MSG91_AUTH_KEY OR MSG91_AUTH_TOKEN.
MSG91_AUTH_KEY=
# Optional (if you already have token instead of auth key)
MSG91_AUTH_TOKEN=

# Required for Flow API sending
MSG91_FLOW_ID=
# Optional: sender id (depends on MSG91 setup)
MSG91_SENDER_ID=
MSG91_BASE_URL=https://api.msg91.com/api/v5/flow/

# Twilio fallback
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# JWT & Auth
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Browser access control
# Production/staging: set the exact frontend origins allowed to call the backend.
CORS_ALLOWED_ORIGINS=
FRONTEND_URL=http://localhost:5173

# Local development helpers
# Add extra local origins here when testing from a second machine or a non-default port.
FRONTEND_DEV_ORIGINS=http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
FRONTEND_DEV_PORT=5173
FRONTEND_PREVIEW_PORT=4173

# Email (disabled by default)
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
ADMIN_EMAIL=

# App
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001
LOG_LEVEL=info

# Demo-only OTP override for staging/testing.
# Keep disabled by default, and only allow specific tester phone numbers.
TEST_OTP_ENABLED=false
TEST_OTP_CODE=
TEST_OTP_ALLOWED_PHONES=

# Uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf
